<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/appTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="APPSIoT - Lab 2"
        android:textAlignment="center"
        android:textSize="20sp"
        android:background="@drawable/title_border"
        android:padding="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvBienvenido"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bienvenido"
        android:textStyle="bold"
        android:textSize="30sp"
        app:layout_constraintTop_toBottomOf="@id/appTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"/>

    <ImageView
        android:id="@+id/imgIcono"
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:src="@drawable/ic_satellite"
        android:contentDescription="Icono de bienvenida"
        app:layout_constraintTop_toBottomOf="@id/tvBienvenido"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp"/>

    <Button
        android:id="@+id/btnSoftware"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="Software"
        android:textColor="#000000"
        app:strokeColor="#000000"
        app:strokeWidth="1dp"
        android:backgroundTint="@android:color/transparent"
        app:cornerRadius="0dp"
        app:layout_constraintTop_toBottomOf="@id/imgIcono"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp"/>

    <Button
        android:id="@+id/btnCiberseguridad"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="Ciberseguridad"
        android:textColor="#000000"
        app:strokeColor="#000000"
        app:strokeWidth="1dp"
        android:backgroundTint="@android:color/transparent"
        app:cornerRadius="0dp"
        app:layout_constraintTop_toBottomOf="@id/btnSoftware"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/btnOpticas"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="Ópticas"
        android:textColor="#000000"
        app:strokeColor="#000000"
        app:strokeWidth="1dp"
        android:backgroundTint="@android:color/transparent"
        app:cornerRadius="0dp"
        app:layout_constraintTop_toBottomOf="@id/btnCiberseguridad"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp" />

</androidx.constraintlayout.widget.ConstraintLayout>